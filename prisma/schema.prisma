datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentSource {
  WEBSITE
  PHONE_AI_AGENT
  WALK_IN
  MANUAL_ADMIN
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallOutcome {
  BOOKED
  RESCHEDULED
  CANCELLED
  INQUIRY_ONLY
  FOLLOW_UP_NEEDED
  MISSED
}

enum Role {
  ADMIN
  PHYSIO
}

enum AppointmentType {
  CONSULTATION
  CONSULTATION_TREATMENT
  TREATMENT
  FOLLOW_UP
  CRANIOSACRAL_THERAPY
}

model Patient {
  id                        String           @id @default(cuid())
  fullName                  String
  gender                    String
  dateOfBirth               DateTime
  phone                     String
  secondaryPhone            String?
  address                   String?
  referringDoctor           String?
  presentingComplaint       String?
  diagnosis                 String?
  treatmentModalityAssigned String?
  intakeDate                DateTime         @default(now())
  tags                      String           @default("") // Comma-separated list for SQLite compatibility
  notes                     String?
  expectedCadence           String           @default("weekly") // "weekly" or "biweekly"
  assignedProtocolId        String?
  currentProtocolStep       Int              @default(0)
  attachments               Attachment[]
  appointments              Appointment[]
  callLogs                  CallLog[]
  sessionPackages           SessionPackage[]
  patientPackages           PatientPackage[]
  invoices                  Invoice[]
  feedback                  Feedback[]
  waitlists                 Waitlist[]
  sentHandouts              SentHandout[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
}

model Attachment {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name       String
  url        String
  fileType   String
  uploadedAt DateTime @default(now())
}

model Appointment {
  id                   String             @id @default(cuid())
  patientId            String
  patient              Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date                 DateTime
  startTime            String
  endTime              String
  status               AppointmentStatus  @default(SCHEDULED)
  appointmentType      AppointmentType?
  treatmentType        String
  assignedSlotDuration Int                @default(30)
  durationMinutes      Int?
  source               AppointmentSource  @default(MANUAL_ADMIN)
  notes                String?
  checkInTime          DateTime?
  checkInAt            DateTime?
  checkOutAt           DateTime?
  seenTime             DateTime?
  assignedPhysioId     String?
  assignedPhysio       User?              @relation("PhysioAppointments", fields: [assignedPhysioId], references: [id], onDelete: SetNull)
  feedback             Feedback?
  assignedExercises    AssignedExercise[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model CallLog {
  id               String        @id @default(cuid())
  patientId        String?
  patient          Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  direction        CallDirection
  phoneNumber      String
  timestamp        DateTime      @default(now())
  duration         Int
  transcript       String?
  summary          String?
  outcome          CallOutcome
  recordingUrl     String?
  followUpActioned Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model TreatmentModality {
  id              String  @id @default(cuid())
  name            String
  description     String?
  defaultDuration Int     @default(30)
  category        String
}

model ClinicSettings {
  id                           String   @id @default("clinic_settings")
  name                         String   @default("Health360")
  tagline                      String?  @default("Physiotherapy and Craniosacral Therapy Clinic")
  phone                        String   @default("8482812859")
  email                        String   @default("health360vasai@gmail.com")
  address                      String   @default("Shop No.1, Amardeep Society, Om Nagar, Vasai (W).")
  primaryDoctor                String   @default("Dr. Rashmita Karvir Kekre")
  doctorNameCredentials        String   @default("Dr. Rashmita Karvir Kekre\nB.PTh.(M.I.A.P.)\nBCST")
  logoUrl                      String?  @default("/logo/rklogo.png")
  website                      String?  @default("health360vasai@gmail.com")
  upiId                        String?  @default("8482812859@upi")
  registrationNumber           String?
  workingHoursStart            String   @default("10:00")
  workingHoursEnd              String   @default("21:00")
  slotDuration                 Int      @default(15)
  maxConcurrentPatientsPerSlot Int      @default(2)
  holidays                     String   @default("") // Comma-separated list for SQLite compatibility
  isPubliclyVisible            Boolean  @default(true)
  reminder24hTemplate          String   @default("Hi {patient}, this is a reminder for your session tomorrow at {time}.")
  reminder2hTemplate           String   @default("Hi {patient}, you have an appointment in 2 hours at {time}.")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model User {
  id                   String            @id @default(cuid())
  username             String            @unique
  password             String
  email                String?           @unique
  phone                String?
  designation          String?           @default("Physiotherapist")
  role                 Role              @default(PHYSIO)
  isActive             Boolean           @default(true)
  joinedDate           DateTime?         @default(now())
  assignedAppointments Appointment[]     @relation("PhysioAppointments")
  attendances          StaffAttendance[]
  documents            StaffDocument[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model StaffAttendance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  clockInAt  DateTime
  clockOutAt DateTime?
  date       DateTime  @db.Date
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([userId, date])
}

model StaffInvite {
  id          String   @id @default(cuid())
  email       String
  token       String   @unique
  role        Role     @default(PHYSIO)
  designation String
  name        String
  phone       String?
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model StaffDocument {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  documentType String
  issueDate    DateTime?
  expiryDate   DateTime?
  notes        String?
  uploadedBy   String
  uploadedAt   DateTime  @default(now())

  @@index([userId])
}

model ClinicHoliday {
  id              String   @id @default(cuid())
  date            DateTime @db.Date @unique
  name            String
  repeatsAnnually Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model SessionPackage {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  packageName     String
  totalSessions   Int
  sessionsUsed    Int      @default(0)
  subSessionNames String?  // Comma-separated or JSON list of sub-session names
  subSessionNotes String?  // JSON list of notes for each session
  price           Float?
  paidAmount      Float?   @default(0)
  paymentStatus   String   @default("PENDING") // PENDING, PAID, PARTIAL
  purchaseDate    DateTime @default(now())
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TreatmentProtocol {
  id                     String   @id @default(cuid())
  name                   String
  associatedDiagnosisTag String
  steps                  String   // Comma-separated list of modalities for SQLite compatibility
  description            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Feedback {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  submittedAt   DateTime    @default(now())
}

model Waitlist {
  id                   String   @id @default(cuid())
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  desiredTreatmentType String
  preferredTimeWindow  String   // "MORNING", "AFTERNOON", "EVENING"
  status               String   @default("WAITING") // "WAITING", "FILLED", "EXPIRED"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   // "BOOKING", "CANCELLATION", "CALL_FOLLOWUP"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ExerciseTemplate {
  id               String @id @default(cuid())
  name             String
  defaultSets      String @default("3")
  defaultReps      String @default("10")
  defaultHoldTime  String @default("5s")
  defaultFrequency String @default("Once daily")
}

model AssignedExercise {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  name          String
  sets          String
  reps          String
  holdTime      String
  frequency     String
}

model Handout {
  id           String        @id @default(cuid())
  title        String
  url          String
  fileType     String
  category     String
  sentHandouts SentHandout[]
}

model SentHandout {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  handoutId String
  handout   Handout  @relation(fields: [handoutId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
  sentVia   String
}

model OtpRequest {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model InboxMessage {
  id             String   @id @default(cuid())
  type           String   // "CONTACT", "REFERRAL", "CAREERS"
  name           String
  email          String
  phone          String
  message        String?
  metadata       String?  // JSON string for extra fields like role or referral details
  attachmentUrl  String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

model TreatmentPlan {
  id               String           @id @default(cuid())
  name             String           @unique
  description      String?
  minModalities    Int?
  maxModalities    Int?
  includesExercise Boolean          @default(true)
  perSessionRate   Decimal          @db.Decimal(10, 2)
  packageRate      Decimal          @db.Decimal(10, 2)
  isActive         Boolean          @default(true)
  displayOrder     Int              @default(0)
  patientPackages  PatientPackage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model PatientPackage {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  planId        String
  plan          TreatmentPlan @relation(fields: [planId], references: [id])
  daysPurchased Int
  ratePerDay    Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  sessionsUsed  Int           @default(0)
  purchaseDate  DateTime      @default(now())
  expiryDate    DateTime?
  status        PackageStatus @default(ACTIVE)
  invoiceId     String?
  invoiceLines  InvoiceLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([patientId, status])
}

model ConsumableProduct {
  id        String   @id @default(cuid())
  name      String
  unitPrice Decimal  @db.Decimal(10, 2)
  unit      String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCharge {
  id                    String          @id @default(cuid())
  appointmentType       AppointmentType @unique
  rate                  Decimal         @db.Decimal(10, 2)
  isBilledByPlan        Boolean         @default(false)
  requiresBillingChoice Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date           DateTime      @default(now())
  dueDate        DateTime?
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  status         InvoiceStatus @default(PENDING)
  notes          String?
  lines          InvoiceLine[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model InvoiceLine {
  id                 String          @id @default(cuid())
  invoiceId          String
  invoice            Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description        String
  quantity           Int             @default(1)
  unitPrice          Decimal         @db.Decimal(10, 2)
  totalPrice         Decimal         @db.Decimal(10, 2)
  isCoveredByPackage Boolean         @default(false)
  patientPackageId   String?
  patientPackage     PatientPackage? @relation(fields: [patientPackageId], references: [id])
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(10, 2)
  paymentMode     String   // "Cash", "UPI", "Card", "Bank transfer"
  referenceNumber String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
}
